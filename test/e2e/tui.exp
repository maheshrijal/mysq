#!/usr/bin/expect -f

set interaction_timeout 25
set timeout 60
log_user 0
set binary [lindex $argv 0]
set dsn [lindex $argv 1]
set pty_log [lindex $argv 2]
log_file -a -noappend $pty_log
spawn -noecho $binary tui $dsn --interval 250ms
# Give Bubble Tea a deterministic initial viewport even when this harness is
# launched by a headless CI runner with no inherited terminal dimensions.
set spawn_tty [exp_open -leaveopen -i $spawn_id]
exec stty rows 38 columns 130 <@ $spawn_tty
close $spawn_tty
expect {
  -re {Refreshed [0-9:]+ .* snapshot [0-9a-f]+} {}
  timeout { exit 10 }
  eof { exit 11 }
}
set timeout $interaction_timeout
# Exercise horizontal view navigation, vertical query selection, and the
# Enter/Esc query detail workflow.
send "\033\[C"
expect -re {● 2 CONNECTIONS}
send "\033\[C"
expect -re {● 3 QUERIES}
# Queries use vertical arrows for row selection and Enter/Esc for detail.
send "\033\[B"
send "\r"
expect -re {NORMALIZED SQL}
send "\033"
expect -re {DB TIME.*CALLS.*P95.*USER.*QUERY}
send "\033\[D"
expect -re {● 2 CONNECTIONS}
send "\033\[D"
expect -re {● 1 OVERVIEW}
# Engine is longer than the viewport. Vertical arrows scroll its content and
# must not switch tabs.
send "4"
expect -re {● 4 ENGINE}
for {set i 0} {$i < 30} {incr i} {
  send "\033\[B"
}
expect -re {MYSQL FILE I/O|MYSQL ERRORS AND WARNINGS}
send "\033\[A"
expect -re {● 4 ENGINE}
send "\t"
send "\t"
send "e"
expect {
  -re {Agent bundle exported:} {}
  timeout { exit 12 }
  eof { exit 13 }
}
send "r"
expect {
  -re {Refreshed [0-9:]+ .* snapshot [0-9a-f]+} {}
  timeout { exit 14 }
  eof { exit 15 }
}
send "q"
expect eof
catch wait result
set exit_code [lindex $result 3]
if {$exit_code != 0} {
  exit $exit_code
}

#!/usr/bin/expect -f

set interaction_timeout 25
set timeout 60
log_user 0
set binary [lindex $argv 0]
set endpoint [lindex $argv 1]
set pty_log [lindex $argv 2]
log_file -a -noappend $pty_log
spawn -noecho $binary tui --interval 250ms
# Give Bubble Tea a deterministic initial viewport even when this harness is
# launched by a headless CI runner with no inherited terminal dimensions.
set spawn_tty [exp_open -leaveopen -i $spawn_id]
exec stty rows 38 columns 130 <@ $spawn_tty
close $spawn_tty
expect {
  -re {CONNECT TO MYSQL} {}
  timeout { exit 8 }
  eof { exit 9 }
}
send -- "$endpoint\r"
expect {
  # The scored health header is the stable loaded-state contract. Footer
  # status text is intentionally responsive and may be compacted.
  -re {● (HEALTHY|ATTENTION|CRITICAL|PARTIAL|REVIEW)[[:space:]]+[0-9]+} {}
  timeout { exit 10 }
  eof { exit 11 }
}
set timeout $interaction_timeout
# Trends sample independently from the full diagnostic snapshot. At this
# viewport size they are sparklines below the summary, reachable by End.
send "G"
expect -re {LIVE TRENDS}
expect -re {peak [0-9]}
send "p"
expect -re {PAUSED.*p resume}
send "p"
expect -re {LIVE.*every 2s.*p pause}
send "g"
expect -re {PRIORITY SIGNAL}
# Findings-first overview opens the same evidence exported for agents.
send "B"
expect -re {BLOCKING CHAINS}
send "\033"
expect -re {PRIORITY SIGNAL}
send "5"
expect -re {FINDINGS.*ENTER TO INVESTIGATE}
send "\r"
expect -re {FINDING EVIDENCE}
send "\033"
expect -re {FINDINGS.*ENTER TO INVESTIGATE}
send "1"
expect -re {PRIORITY SIGNAL}
# Exercise horizontal view navigation, vertical query selection, and the
# Enter/Esc query detail workflow.
send "\033\[C"
expect -re {● 2 CONNECTIONS}
send "\033\[C"
expect -re {● 3 QUERIES}
# Contextual help is a real scrollable view and Esc returns to the current
# query list without changing tabs.
send "?"
expect -re {KEYBOARD HELP}
send "\033"
expect -re {DB TIME.*CALLS.*P95.*USER.*QUERY}
# Filter the current view to an impossible value, apply it, then clear it with
# Esc. The post-Enter footer count is absent while the editor still has focus,
# so a broken apply transition cannot satisfy this assertion from stale bytes.
send "/"
send "mysq-no-match"
send "\r"
expect -re {Filter "mysq-no-match".*0/[0-9]+}
send "\033"
expect -re {DB TIME.*CALLS.*P95.*USER.*QUERY}
# Queries use vertical arrows for row selection and Enter/Esc for detail.
send "\033\[B"
send "\r"
expect -re {QUERY 2 OF [0-9]+}
expect -re {NORMALIZED SQL}
# The stopped workload leaves historical digests, never cancellation targets.
send "K"
expect -re {Choose an execution}
expect -re {No matching instrumented execution visible now}
send "\r"
send "\033"
expect -re {QUERY 2 OF [0-9]+}
send "\033"
expect -re {DB TIME.*CALLS.*P95.*USER.*QUERY}
send "\033\[D"
expect -re {● 2 CONNECTIONS}
send "\033\[D"
expect -re {● 1 OVERVIEW}
# Engine is longer than the viewport. Vertical arrows scroll its content and
# must not switch tabs.
send "4"
expect -re {● 4 ENGINE}
for {set i 0} {$i < 30} {incr i} {
  send "\033\[B"
}
expect -re {MYSQL FILE I/O|MYSQL ERRORS AND WARNINGS}
send "\033\[A"
expect -re {● 4 ENGINE}
send "\t"
expect -re {● 5 FINDINGS}
send "\t"
expect -re {● 6 TABLES}
send "e"
expect {
  -re {Agent bundle exported:} {}
  timeout { exit 12 }
  eof { exit 13 }
}
send "r"
expect {
  -re {collecting} {}
  timeout { exit 14 }
  eof { exit 15 }
}
expect {
  -re {Refreshed [0-9:]+ .* snapshot [0-9a-f]+} {}
  timeout { exit 14 }
  eof { exit 15 }
}
send "q"
expect eof
catch wait result
set exit_code [lindex $result 3]
if {$exit_code != 0} {
  exit $exit_code
}
